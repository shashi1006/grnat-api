# ===================================================
# ReadyGeneration Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ===================================================

# --- Server ---
PORT=8080
APP_ENV=development

# --- Database ---
DATABASE_URL=postgres://rg:rg_secret@localhost:5432/readygeneration?sslmode=disable

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- JWT ---
JWT_SECRET=change_me_to_a_long_random_secret_string
JWT_TTL_SECONDS=3600

# --- Anthropic Claude ---
ANTHROPIC_API_KEY=sk-ant-...

# --- OpenAI Embeddings ---
OPENAI_API_KEY=sk-...

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://readygeneration.com
